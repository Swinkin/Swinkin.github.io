</th>
<td style="width:50"><span typeof="mw:File"><a href="/wiki/%D0%A4%D0%B0%D0%B9%D0%BB:Coat_of_arms_of_Moscow.svg" class="mw-file-description" title="Герб Москвы"><img alt="Герб Москвы" src="//upload.wikimedia.org/wikipedia/commons/thumb/1/17/Coat_of_arms_of_Moscow.svg/60px-Coat_of_arms_of_Moscow.svg.png" decoding="async" width="50" height="59" class="mw-file-element" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/1/17/Coat_of_arms_of_Moscow.svg/120px-Coat_of_arms_of_Moscow.svg.png 1.5x" data-file-width="558" data-file-height="663" /></a></span>
</td></tr>
<tr>
<th scope="row" style="background:transparent; text-align:left"><a href="/wiki/%D0%90%D0%B4%D0%BC%D0%B8%D0%BD%D0%B8%D1%81%D1%82%D1%80%D0%B0%D1%82%D0%B8%D0%B2%D0%BD%D0%BE-%D1%82%D0%B5%D1%80%D1%80%D0%B8%D1%82%D0%BE%D1%80%D0%B8%D0%B0%D0%BB%D1%8C%D0%BD%D0%BE%D0%B5_%D0%B4%D0%B5%D0%BB%D0%B5%D0%BD%D0%B8%D0%B5_%D0%9C%D0%BE%D1%81%D0%BA%D0%B2%D1%8B" title="Административно-территориальное деление Москвы">Административных округов</a>
</th>
