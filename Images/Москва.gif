<li class="toclevel-2 tocsection-4"><a href="#Палеонтология"><span class="tocnumber">2.2</span> <span class="toctext">Палеонтология</span></a></li>
<li class="toclevel-2 tocsection-5"><a href="#Климат"><span class="tocnumber">2.3</span> <span class="toctext">Климат</span></a></li>
<li class="toclevel-2 tocsection-6"><a href="#Растительность"><span class="tocnumber">2.4</span> <span class="toctext">Растительность</span></a></li>
<li class="toclevel-2 tocsection-7"><a href="#Животный_мир"><span class="tocnumber">2.5</span> <span class="toctext">Животный мир</span></a></li>
<li class="toclevel-2 tocsection-8"><a href="#Экология"><span class="tocnumber">2.6</span> <span class="toctext">Экология</span></a></li>
</ul>
</li>
<li class="toclevel-1 tocsection-9"><a href="#История"><span class="tocnumber">3</span> <span class="toctext">История</span></a>
<ul>
<li class="toclevel-2 tocsection-10"><a href="#Первые_поселения"><span class="tocnumber">3.1</span> <span class="toctext">Первые поселения</span></a></li>
<li class="toclevel-2 tocsection-11"><a href="#Москва_—_столица_княжества"><span class="tocnumber">3.2</span> <span class="toctext">Москва&#160;— столица княжества</span></a>
<ul>
<li class="toclevel-3 tocsection-12"><a href="#Духовная_столица_Руси"><span class="tocnumber">3.2.1</span> <span class="toctext">Духовная столица Руси</span></a></li>
</ul>
</li>
<li class="toclevel-2 tocsection-13"><a href="#Русское_царство"><span class="tocnumber">3.3</span> <span class="toctext">Русское царство</span></a>
